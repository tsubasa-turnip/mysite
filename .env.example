# Local development: leave external services unset. Encrypted data is stored in .inner-weather.
# Production requires Supabase Auth, PostgreSQL, HTTPS, and a persistent encryption key.
# DATABASE_SSL_CA_FILE=/path/to/trusted-supabase-ca.crt
# DATABASE_SSL_CA=optional-trusted-supabase-ca-PEM-for-Vercel
# DATABASE_URL=postgresql://...  (Supabase transaction pooler; percent-encode password)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-publishable-or-anon-key
# SUPABASE_SERVICE_ROLE_KEY=server-only-admin-key-required-for-account-deletion
# DATA_ENCRYPTION_KEY=64-hex-characters-generated-with-openssl-rand-hex-32
# APP_ORIGIN=https://your-domain.example
# OPENAI_API_KEY=server-only-key
# IW_OPENAI_API_KEY=cloud-proxy-binding-alternative-to-OPENAI_API_KEY
OPENAI_MODEL=gpt-4.1-mini
# Used for estimates only, USD per million tokens; update for your selected model.
AI_INPUT_USD_PER_MILLION=0.4
AI_OUTPUT_USD_PER_MILLION=1.6
AI_JOB_BUDGET_USD=1
# Optional authenticated scheduler: POST /api/worker with Authorization: Bearer ...
# WORKER_SECRET=at-least-32-random-characters

# Container upload maximum is 25 MB. Set 4 for Vercel function uploads.
MAX_UPLOAD_MB=25
