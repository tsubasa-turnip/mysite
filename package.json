{
  "name": "inner-weather",
  "version": "1.0.0",
  "description": "A private journaling app with traceable ChatGPT import and emotional timelines",
  "main": "index.js",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "worker": "tsx scripts/worker.ts",
    "migrate": "tsx scripts/migrate.ts",
    "verify:live": "tsx scripts/verify-live.ts",
    "check:deploy": "tsx scripts/check-deploy.ts",
    "format": "prettier --write src scripts tests *.ts *.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsubasa-turnip/mysite.git"
  },
