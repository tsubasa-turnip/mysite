  },
  "homepage": "https://github.com/tsubasa-turnip/mysite#readme",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@radix-ui/react-dialog": "^1.2.0",
    "@supabase/supabase-js": "^2.117.3",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.53.0",
    "next": "^16.4.0",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
